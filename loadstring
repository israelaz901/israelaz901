--========================================================
-- SELETOR DE COR (amostras + barra de matiz)
--========================================================

local function textoContraste(c)
    local lum = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
    if lum > 0.55 then
        return Color3.new(0, 0, 0)
    end
    return Color3.new(1, 1, 1)
end

local function criarSeletorCor(parent, corInicial, aoMudar)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 195)
    frame.BackgroundColor3 = Color3.fromRGB(18, 18, 21)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.ZIndex = 55
    frame.LayoutOrder = proximaOrdem()
    frame.Parent = parent

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 10)
    fc.Parent = frame

    local preview = Instance.new("TextLabel")
    preview.Size = UDim2.new(1, -10, 0, 26)
    preview.Position = UDim2.fromOffset(5, 5)
    preview.BackgroundColor3 = corInicial
    preview.Text = "COR ESCOLHIDA"
    preview.TextColor3 = textoContraste(corInicial)
    preview.TextSize = 11
    preview.Font = Enum.Font.GothamBold
    preview.BorderSizePixel = 0
    preview.ZIndex = 56
    preview.Parent = frame

    local pc = Instance.new("UICorner")
    pc.CornerRadius = UDim.new(0, 7)
    pc.Parent = preview

    local function escolher(c)
        preview.BackgroundColor3 = c
        preview.TextColor3 = textoContraste(c)
        aoMudar(c)
    end

    -- leque de amostras
    local grade = Instance.new("Frame")
    grade.Size = UDim2.new(1, -10, 0, 120)
    grade.Position = UDim2.fromOffset(5, 37)
    grade.BackgroundTransparency = 1
    grade.ZIndex = 56
    grade.Parent = frame

    local gl = Instance.new("UIGridLayout")
    gl.CellSize = UDim2.fromOffset(17, 17)
    gl.CellPadding = UDim2.fromOffset(3, 3)
    gl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gl.SortOrder = Enum.SortOrder.LayoutOrder
    gl.Parent = grade

    local amostras = {}

    for _, v in ipairs({1, 0.85, 0.7, 0.55, 0.4, 0.25, 0.12, 0}) do
        table.insert(amostras, Color3.fromHSV(0, 0, v))
    end

    local matizes = {0, 28, 52, 125, 180, 215, 270, 320}
    local tons = {{0.3, 1}, {0.6, 1}, {1, 1}, {1, 0.7}, {1, 0.4}}
    for _, t in ipairs(tons) do
        for _, h in ipairs(matizes) do
            table.insert(amostras, Color3.fromHSV(h / 360, t[1], t[2]))
        end
    end

    for i, c in ipairs(amostras) do
        local a = Instance.new("TextButton")
        a.Text = ""
        a.BackgroundColor3 = c
        a.BorderSizePixel = 0
        a.AutoButtonColor = false
        a.ZIndex = 57
        a.LayoutOrder = i
        a.Parent = grade
        local ac = Instance.new("UICorner")
        ac.CornerRadius = UDim.new(0, 4)
        ac.Parent = a
        a.Activated:Connect(function() escolher(c) end)
    end

    -- barra de matiz
    local barra = Instance.new("Frame")
    barra.Size = UDim2.new(1, -10, 0, 20)
    barra.Position = UDim2.fromOffset(5, 167)
    barra.BackgroundColor3 = Color3.new(1, 1, 1)
    barra.BorderSizePixel = 0
    barra.ZIndex = 56
    barra.Parent = frame

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 6)
    bc.Parent = barra

    local pontos = {}
    for i = 0, 5 do
        table.insert(pontos, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
    end
    table.insert(pontos, ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)))

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new(pontos)
    grad.Parent = barra

    local arrastandoBarra = false
    local function ajustarPorX(x)
        local largura = barra.AbsoluteSize.X
        if largura <= 0 then return end
        local rel = math.clamp((x - barra.AbsolutePosition.X) / largura, 0, 1)
        escolher(Color3.fromHSV(rel, 1, 1))
    end

    barra.InputBegan:Connect(function(input)
        if tipoPonteiro(input) then
            arrastandoBarra = true
            ajustarPorX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not arrastandoBarra then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            ajustarPorX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if tipoPonteiro(input) then
            arrastandoBarra = false
        end
    end)

    return frame
end

