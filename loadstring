--========================================================

local function posicionarPainel(p)
    local pos = icon.AbsolutePosition
    local tam = icon.AbsoluteSize
    local tela = workspace.CurrentCamera.ViewportSize
    local largura = p.Size.X.Offset
    local altura = p.Size.Y.Offset
    local x = pos.X + tam.X + 8
    local y = pos.Y
    if x + largura > tela.X then
        x = pos.X - largura - 8
    end
    y = math.clamp(y, 5, math.max(5, tela.Y - altura - 5))
    p.Position = UDim2.fromOffset(x, y)
end

local function algumSecundarioVisivel()
    for i = 2, #todosPaineis do
        if todosPaineis[i].Visible then return true end
    end
    return false
end

local function mostrarPainel(p)
    for _, x in ipairs(todosPaineis) do
        x.Visible = false
    end
    if p then
        p.Visible = true
        posicionarPainel(p)
    end
end

