--========================================================
-- ENVIO PARA O CHAT
--========================================================

local function enviarComandoChat(msg)
    local ok, err = pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local canais = TextChatService:FindFirstChild("TextChannels")
            local canal = canais and canais:FindFirstChild("RBXGeneral")
            if not canal and canais then
                canal = canais:FindFirstChildWhichIsA("TextChannel")
            end
            if not canal then
                error("nenhum canal de texto encontrado")
            end
            canal:SendAsync(msg)
        else
            local evt = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local req = evt and evt:FindFirstChild("SayMessageRequest")
            if not req then
                error("chat antigo indisponivel neste jogo")
            end
            req:FireServer(msg, "All")
        end
    end)
    if not ok then
        warn("[NETT] Nao foi possivel enviar no chat: " .. tostring(err))
    end
end

-- Botao de comando: quebra o texto em linhas e ajusta a altura
local function botaoComando(parent, texto)
    local btn = botao(parent, texto)
    local tamanho = utf8.len(texto) or #texto
    btn.TextWrapped = true
    btn.TextSize = 11
    if tamanho > 52 then
        btn.Size = UDim2.new(1, 0, 0, 68)
    elseif tamanho > 26 then
        btn.Size = UDim2.new(1, 0, 0, 52)
    end
    btn.Activated:Connect(function()
        enviarComandoChat(texto)
    end)
    return btn
end

