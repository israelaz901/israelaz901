-- Arrastar o icone (mouse ou toque)
local arrastandoIcone = false
local inicioMouse = nil
local inicioPosicao = nil
local moveuIcone = false

local function tipoPonteiro(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

icon.InputBegan:Connect(function(input)
    if tipoPonteiro(input) then
        arrastandoIcone = true
        inicioMouse = input.Position
        inicioPosicao = icon.Position
        moveuIcone = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not arrastandoIcone then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    local delta = input.Position - inicioMouse
    if delta.Magnitude > 5 then moveuIcone = true end
    icon.Position = UDim2.new(
        inicioPosicao.X.Scale,
        inicioPosicao.X.Offset + delta.X,
        inicioPosicao.Y.Scale,
        inicioPosicao.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if tipoPonteiro(input) then
        arrastandoIcone = false
    end
end)

